# 复制为 .env 并填上真实值。
# .env 已被 .gitignore 忽略，绝不提交；本文件（.env.example）是模板，要提交。
#
# 注意：Spring Boot 本身不读 .env 文件。两种用法：
#   1) IDE 开发：把下面的键值填进 Run Configuration 的 Environment variables
#   2) 命令行：source .env && mvn spring-boot:run
#   （G8 上 Docker Compose 后由 compose 的 env_file 直接注入）

DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# ANTHROPIC_API_KEY=

# ---- 管理接口（G6）----
# 不配置时 /admin/** 一律 403（fail-closed）。
# 生产上必须是强随机值，并且只在内网暴露该路径。
GATEWAY_ADMIN_TOKEN=dev-admin-token

# ---- 保护组件（G4 / G7）----
# 生产环境建议两个都打开；本地开发可以关掉（启动时会打 WARN 提醒你）
# GATEWAY_RATE_LIMIT_ENABLED=true
# GATEWAY_BILLING_ENABLED=true
# GATEWAY_BILLING_INITIAL_CREDITS=1000000

# ---- 路由（G6）----
# GATEWAY_AUTO_ROUTE=true
# GATEWAY_FAILOVER_ENABLED=true

# ---- 客户端鉴权（G10）----
# 格式 clientId:sha256Hex，多个用逗号分隔。只存哈希，不存明文 key。
# 生成方式：echo -n 'sk-your-key' | sha256sum
# 下面的 demo 值是 sk-gw-dev-demo-key-0123456789 的 SHA-256（公开的开发用 key）。
# 生产必须换成自己的随机 key 并用上面的命令生成哈希。
# GATEWAY_AUTH_ENABLED=true
# GATEWAY_AUTH_KEYS=demo:1fcd8ad3c239fa16ed49dd131f0e038f5447b8b8fefa75de15b15fb47de45ade

# ---- 多实例渠道状态（G11）----
# memory：单机内存（默认）；redis：多实例共享状态，必须配 Redis
# GATEWAY_CHANNEL_STATE_MODE=memory

# ---- 链路追踪（G13）----
# 生产按 QPS 调低采样率（1%~10%），全采样只适合演示
# GATEWAY_TRACING_ENABLED=true
# GATEWAY_TRACE_SAMPLING=1.0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# 以下都有默认值，一般不用改
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# GATEWAY_CONNECT_TIMEOUT_MS=3000
# GATEWAY_READ_TIMEOUT_MS=30000
# SPRING_DATA_REDIS_HOST=localhost
# SPRING_DATA_REDIS_PORT=6379
