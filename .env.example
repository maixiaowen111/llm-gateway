# 复制为 .env 并填上真实值。
# .env 已被 .gitignore 忽略，绝不提交；本文件（.env.example）是模板，要提交。
#
# 注意：Spring Boot 本身不读 .env 文件。两种用法：
#   1) IDE 开发：把下面的键值填进 Run Configuration 的 Environment variables
#   2) 命令行：source .env && mvn spring-boot:run
#   （G8 上 Docker Compose 后由 compose 的 env_file 直接注入）

DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=
# ANTHROPIC_API_KEY=

# ---- 管理接口（G6）----
# 不配置时 /admin/** 一律 403（fail-closed）。
# 生产上必须是强随机值，并且只在内网暴露该路径。
GATEWAY_ADMIN_TOKEN=dev-admin-token

# ---- 保护组件（G4 / G7）----
# 生产环境建议两个都打开；本地开发可以关掉（启动时会打 WARN 提醒你）
# GATEWAY_RATE_LIMIT_ENABLED=true
# GATEWAY_BILLING_ENABLED=true
# GATEWAY_BILLING_INITIAL_CREDITS=1000000

# ---- 路由（G6）----
# GATEWAY_AUTO_ROUTE=true
# GATEWAY_FAILOVER_ENABLED=true

# 以下都有默认值，一般不用改
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# GATEWAY_CONNECT_TIMEOUT_MS=3000
# GATEWAY_READ_TIMEOUT_MS=30000
# SPRING_DATA_REDIS_HOST=localhost
# SPRING_DATA_REDIS_PORT=6379
