<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 3.5.5：本机 m2 里已缓存，省一次下载。3.x 是路线 §七 定的，不要降回 2.7 -->
        <version>3.5.5</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>llm-gateway</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>llm-gateway</name>
    <description>LLM 模型网关：多渠道路由 / 限流 / 熔断 / 计量</description>

    <properties>
        <!-- 本机 Maven 跑在 JDK 17 上，跟随它，避免 toolchain 报错 -->
        <java.version>17</java.version>

        <!-- G5 / G9 的第三方版本集中在这里：升级只改一行，不散落在 dependency 里 -->
        <resilience4j.version>2.3.0</resilience4j.version>
        <logstash-encoder.version>8.0</logstash-encoder.version>

        <!-- ★ G4：Testcontainers 用的 Docker API 版本，必须显式指定 ★
             本机 Docker Engine 29.7.2 的【最低】支持版本是 1.40，
             而 Testcontainers 1.21.3 里 docker-java 的默认版本比它低，
             于是探测时收到一个 400 —— 而且是
             "API returned a 400 (Bad Request) but provided no error-message"
             【一个连错误信息都没有的 400】。
             表现是 Testcontainers 报「Could not find a valid Docker environment」，
             把人指向"Docker 没装好/没启动"—— 而实际上 docker CLI 完全正常、容器都在跑。

             验证方法（三十秒就能定性，比读半天源码快）：
                 DOCKER_API_VERSION=1.32 docker info   → 400，且没有错误信息
                 DOCKER_API_VERSION=1.44 docker info   → 正常
             ★ 这条值得记住的不只是配置项，而是那个排查动作：
               遇到"环境不对"的报错，先用底层工具验证一遍事实，再相信上层工具给出的诊断。 -->
        <docker.api.version>1.44</docker.api.version>
    </properties>

    <dependencies>
        <!-- G1 只需要这一个：WebFlux 自带 Netty + Reactor。
             注意不是 spring-boot-starter-web —— 那会把 Tomcat 拉进来，
             两个栈同时存在时 Spring 会优先起 MVC，你的 Mono 就白写了。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- G4：Redis 限流。
             ★ 必须是 reactive 版。普通的 spring-boot-starter-data-redis 会拉来
               spring-data-redis 的**阻塞**客户端（LettuceConnection 的 sync/blocking API），
               在 WebFlux 的事件循环线程上做阻塞 IO，就是把 Netty 的线程池按在地上摩擦 ——
               几个并发请求就能让整个网关停止响应。
               这不是"性能差一点"，是"架构被破坏"。
               reactive 版给的是 ReactiveStringRedisTemplate，返回 Mono/Flux，不阻塞。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>

        <!-- ===== G5：熔断 =====
             只引 circuitbreaker + reactor 两个模块，不引 resilience4j-spring-boot3。
             理由：spring-boot3 那个 starter 会带 AOP/注解自动装配，而本项目要的是
             "每个渠道一个熔断器，渠道名是运行时配置出来的" —— 注解只能标在方法上，
             一个方法没法变成 N 个渠道。程序化 API 才是对的形态。
             少一个 starter 也少一层自动装配的魔法：熔断器什么时候建、叫什么名字、
             失败率窗口多大，全部能在代码里一眼看到。 -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-reactor</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>

        <!-- ===== G9：观测 =====
             actuator 给 /actuator/health、/actuator/metrics；
             prometheus registry 把它们变成 Prometheus 能抓的文本格式。
             没有 registry 时 metrics 端点仍然可用，但 Prometheus 抓不到 ——
             而"面板上能看见"正是 G9 的验收物。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- ===== G9：结构化日志（JSON）=====
             只在 spring.profiles.active=json 时生效（见 logback-spring.xml）。
             默认控制台仍然是人类可读的格式 —— 本地开发天天要 eyeball 日志，
             强制 JSON 只会让人去装一堆美化工具。 -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash-encoder.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- G4：Testcontainers。版本由 spring-boot-starter-parent 托管（1.21.3），
             所以这里不写 <version> —— 手写版本号就是给自己埋一个"两处版本不一致"的雷。 -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 断言 Flux/Mono 专用：StepVerifier。1e 写契约测试要用 -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 1e 的假上游。选 standalone 版是因为它把 Jetty 等依赖全部 relocate 进同一个 jar，
             不会和 Spring Boot 的依赖树打架（非 standalone 版很容易踩版本冲突）。
             G8 的全量回归也是它 —— 有了它，跑测试不需要真实 API Key，也不烧钱。 -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>3.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- G4：把 Docker API 版本传进跑测试的那个 JVM。
                 docker-java 会读环境变量 DOCKER_API_VERSION，
                 所以系统属性和环境变量两条路都铺上 —— 不同的调用路径读的是不同的那一个。
                 （写在 pom 里而不是让每个人手动 export：这个修复要能被提交、被 CI 复现，
                   而不是只存在于某台机器的 shell 历史里。） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <api.version>${docker.api.version}</api.version>
                    </systemPropertyVariables>
                    <environmentVariables>
                        <DOCKER_API_VERSION>${docker.api.version}</DOCKER_API_VERSION>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
